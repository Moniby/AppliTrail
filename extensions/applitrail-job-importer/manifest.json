{
  "manifest_version": 3,
  "name": "AppliTrail Job Importer",
  "description": "Capture a job posting and review it in your AppliTrail account.",
  "version": "1.1.4",
  "action": {
    "default_title": "Save this job to AppliTrail",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["https://applitrail.com/*"],
  "content_scripts": [
    {
      "matches": ["https://applitrail.com/app*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "512": "icon.png"
  }
}
