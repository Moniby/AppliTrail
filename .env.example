# Public application configuration
APPLITRAIL_PUBLIC_URL=http://localhost:3000
APPLITRAIL_RELEASE=development
APPLITRAIL_DATA_DIR=.data

# Existing administrator bootstrap. Prefer a stable identity-provider user ID.
APPLIFLOW_ADMIN_USER_ID=
APPLIFLOW_ADMIN_EMAIL=

# AI generation
OPENAI_API_KEY=

# Billing (demo or stripe)
APPLIFLOW_PAYMENT_MODE=demo
APPLIFLOW_DEMO_PAYMENT_KEY=
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=true
STRIPE_PRODUCT_BASIC=
STRIPE_PRODUCT_STANDARD=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_QUARTERLY=
STRIPE_PRICE_BASIC_SIX_MONTH=
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_QUARTERLY=
STRIPE_PRICE_STANDARD_SIX_MONTH=
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_EXTRA_CREDIT=

# Optional trusted identity headers for a future authenticated gateway.
# Do not accept these headers directly from the public internet.
APPLITRAIL_AUTH_USER_ID_HEADER=oai-authenticated-user-id
APPLITRAIL_AUTH_EMAIL_HEADER=oai-authenticated-user-email
APPLITRAIL_AUTH_FULL_NAME_HEADER=oai-authenticated-user-full-name
APPLITRAIL_AUTH_FULL_NAME_ENCODING_HEADER=oai-authenticated-user-full-name-encoding
